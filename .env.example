# Copie este arquivo para .env e preencha com valores próprios. Nunca faça commit do .env.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Chave do Google AI Studio
GEMINI_API_KEY=

# Opcional: troca o modelo sem alterar o código
GEMINI_MODEL=gemini-3.8-flash

# Token gerado no BotFather
TELEGRAM_BOT_TOKEN=

# Segredo do webhook, criado por você (letras, números, _ e -)
TELEGRAM_WEBHOOK_SECRET=
